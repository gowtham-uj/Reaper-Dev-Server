JWT_ACCESS_SECRET=
HOST_PROJECTS_ROOT=/app/workspace
REAPER_POD_MEMORY_LIMIT=8g
REAPER_POD_CPU_LIMIT=4
REAPER_POD_PIDS_LIMIT=4096
# Central Claude skills store. This path lives inside the cloud_proxy project
# pod and is synchronized by the backend into every Claude project pod.
CLAUDE_SKILLS_STORE=/workspace/cloud_proxy/.cloud-proxy/skills-store
# Resumable file uploads default to the server's maximum 256 MiB request size
# to minimize round trips and fsync pauses while retaining durable checkpoints.
# There is no whole-file limit; capacity comes from the workspace filesystem.
UPLOAD_CHUNK_BYTES=268435456
UPLOAD_STORAGE_RESERVE_BYTES=1073741824
UPLOAD_REQUEST_TIMEOUT_MS=1800000
# Public DNS name or IP address used to reach Reaper.
REAPER_HOST=
# Optional domain for <route>.<domain> publishing. Leave empty for IP publishing.
APEX_DOMAIN=
# Must match APEX_DOMAIN for domain publishing; leave empty for IP publishing.
COOKIE_DOMAIN=

APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
ALLOW_SELF_SIGNUP=false
COOKIE_SECURE=true
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_WINDOW_MS=1200000
AUTH_RATE_LIMIT_MAX=25
LOGIN_FAILURE_LIMIT=3
LOGIN_IP_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW_MS=1200000
LOGIN_LOCKOUT_MS=1200000

